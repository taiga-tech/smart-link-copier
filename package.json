{
    "name": "smart-link-copier",
    "displayName": "Smart link copier",
    "description": "A basic Plasmo extension.",
    "version": "0.0.1",
    "author": "Plasmo Corp. <taiga.dev.n@gmail.com>",
    "type": "module",
    "scripts": {
        "start": "next start",
        "dev": "run-p dev:*",
        "dev:plasmo": "plasmo dev",
        "dev:next": "next dev --port 1947",
        "build": "run-p build:*",
        "build:plasmo": "plasmo build",
        "build:next": "next build",
        "typecheck": "tsc --noEmit",
        "test:coverage": "echo 'TODO: Setup test framework and add coverage command'",
        "format": "prettier --write \"**/*.{js,mjs,jsx,json,ts,tsx,md,mdx,css,html,yml,yaml,scss,sass}\" --ignore-path .prettierignore",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "generate:index": "pnpx tsx scripts/generate/index-files.ts",
        "patch": "pnpx tsx scripts/patch.ts",
        "prepare": "husky"
    },
    "dependencies": {
        "next": "16.0.1",
        "plasmo": "0.90.5",
        "react": "19.2.0",
        "react-dom": "19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@next/eslint-plugin-next": "^16.0.1",
        "@plasmohq/rps": "1.8.7",
        "@plasmohq/storage": "1.15.0",
        "@tailwindcss/postcss": "^4.1.16",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/chrome": "0.1.27",
        "@types/node": "24.10.0",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "eslint": "^9.39.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "globals": "^16.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "postcss": "^8.5.6",
        "prettier": "3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.16",
        "tw-animate-css": "^1.4.0",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.46.2"
    },
    "lint-staged": {
        "*.{js,mjs,jsx,json,ts,tsx,md,mdx,css,html,yml,yaml,scss,sass}": [
            "prettier --write"
        ],
        "*.{js,jsx,ts,tsx}": [
            "pnpm lint"
        ]
    },
    "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
