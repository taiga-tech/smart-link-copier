{
    "name": "smart-link-copier",
    "displayName": "Smart link copier",
    "description": "A basic Plasmo extension.",
    "version": "0.0.1",
    "author": "Plasmo Corp. <foss@plasmo.com>",
    "type": "module",
    "scripts": {
        "start": "next start",
        "dev": "run-p dev:*",
        "dev:plasmo": "plasmo dev",
        "dev:next": "next dev --port 1947",
        "build": "run-p build:*",
        "build:plasmo": "plasmo build",
        "build:next": "next build",
        "typecheck": "tsc --noEmit",
        "test:coverage": "echo 'TODO: Setup test framework and add coverage command'",
        "format": "prettier --write \"**/*.{js,mjs,jsx,json,ts,tsx,md,mdx,css,html,yml,yaml,scss,sass}\" --ignore-path .prettierignore",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "dependencies": {
        "next": "15.5.4",
        "plasmo": "0.90.5",
        "react": "19.2.0",
        "react-dom": "19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@ianvs/prettier-plugin-sort-imports": "4.7.0",
        "@next/eslint-plugin-next": "^15.5.4",
        "@plasmohq/rps": "1.8.7",
        "@plasmohq/storage": "1.15.0",
        "@tailwindcss/postcss": "^4.1.14",
        "@trivago/prettier-plugin-sort-imports": "^5.2.2",
        "@types/chrome": "0.1.24",
        "@types/node": "24.7.1",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.1",
        "@typescript-eslint/eslint-plugin": "^8.46.0",
        "@typescript-eslint/parser": "^8.46.0",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.0",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "postcss": "^8.5.6",
        "prettier": "3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.14",
        "tw-animate-css": "^1.4.0",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.46.0"
    },
    "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd"
}
